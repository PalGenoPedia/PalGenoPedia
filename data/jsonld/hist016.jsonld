  "about": {
    "@type": "Event",
    "name": "Operation Guardian of the Walls",
    "startDate": "2021-05-10",
    "endDate": "44337",
    "description": "11-day Israeli military operation in Gaza Strip",
    "location": {
      "@type": "Place",
      "name": "Gaza Strip, Under Israeli blockade; governed by Hamas, Blockade ongoing; reconstruction incomplete",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.5,
        "longitude": 34.47
