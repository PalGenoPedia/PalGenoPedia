    "@type": "Event",
    "name": "Lydda and Ramle",
    "startDate": "1948-07-09",
    "endDate": "1948-07-13",
    "description": "Operation Dani, 1948 Arab-Israeli War",
    "location": {
      "@type": "Place",
      "name": "Lod and Ramla, Central District, Israel; Cities renamed and repopulated; small Palestinian minority remains",
      "geo": {
        "@type": "GeoCoordinates",
